{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open site in browser",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start local server"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open English version",
      "url": "http://localhost:5500/en/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start local server"
    }
  ]
}
